{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Qt App (Debug)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/TSQT6",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/build",
      "environment": [
        {
          "name": "LD_LIBRARY_PATH",
          "value": "/usr/lib/qt6/lib:${LD_LIBRARY_PATH}"
        },
        {
          "name": "QT_PLUGIN_PATH",
          "value": "/usr/lib/qt6/plugins"
        }
      ],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "logging": { "engineLogging": true }
    },
  ]
}